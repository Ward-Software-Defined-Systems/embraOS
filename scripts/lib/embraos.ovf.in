@@ embraOS OVF descriptor template. write_vm_images (scripts/lib/image-common.sh)
@@ renders it once per architecture: a line that starts with @x86_64@ or
@@ @aarch64@ goes into that architecture's descriptor alone, the tag removed; a
@@ line that starts with @@ goes into neither; the @NAME@-style placeholders
@@ take their values. The x86_64 lines are the descriptor ESXi 8.0 U2 imports
@@ as written: change one and that import is to be run again.
<?xml version="1.0" encoding="UTF-8"?>
@x86_64@<!-- embraOS OVF descriptor, rendered by write_vm_images (scripts/lib/image-common.sh).
@x86_64@     One disk (the whole embraOS GPT image as a streamOptimized VMDK), EFI firmware
@x86_64@     with Secure Boot off (GRUB and the kernel are unsigned), a paravirtual SCSI
@x86_64@     controller and a VMXNET3 adapter (both drivers are in the kernel), at virtual
@x86_64@     hardware version 20 (ESXi 8.0, Fusion 13, Workstation 17). The guest type is
@x86_64@     "Other 6.x or later Linux (64-bit)", vSphere 8.0's name for a kernel like the
@x86_64@     6.18 here: ESXi offers a VM the devices its guest type lists, and the legacy
@x86_64@     "Other Linux (64-bit)" lists neither the paravirtual controller nor VMXNET3,
@x86_64@     so the imported devices showed as blank selections and every edit of the VM
@x86_64@     was refused as invalid. The CIM id 101 is "Linux 64-Bit". -->
@aarch64@<!-- embraOS OVF descriptor for an Arm machine, rendered by write_vm_images
@aarch64@     (scripts/lib/image-common.sh). One disk (the whole embraOS GPT image as a
@aarch64@     streamOptimized VMDK), EFI firmware with Secure Boot off (GRUB and the kernel
@aarch64@     are unsigned), an NVMe controller and a VMXNET3 adapter (the storage and the
@aarch64@     network VMware recommends for an Arm guest; both drivers are in the kernel,
@aarch64@     and the paravirtual SCSI controller of the x86_64 descriptor has no driver in
@aarch64@     an arm64 kernel), and a USB 3 controller for the keyboard and the pointer
@aarch64@     (VMware recommends the USB mouse on the XHCI controller for an Arm guest; its
@aarch64@     vmmouse is not available there). Virtual hardware version 20 (Fusion 13). The
@aarch64@     guest type is "Other 6.x or later Linux (64-bit)", the identifier of the
@aarch64@     x86_64 descriptor: the vSphere API has no guest types of its own for Arm.
@aarch64@     The CIM id 101 is "Linux 64-Bit". -->
<Envelope xmlns="http://schemas.dmtf.org/ovf/envelope/1"
          xmlns:ovf="http://schemas.dmtf.org/ovf/envelope/1"
          xmlns:rasd="http://schemas.dmtf.org/wbem/wscim/1/cim-schema/2/CIM_ResourceAllocationSettingData"
          xmlns:vssd="http://schemas.dmtf.org/wbem/wscim/1/cim-schema/2/CIM_VirtualSystemSettingData"
          xmlns:vmw="http://www.vmware.com/schema/ovf"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <References>
    <File ovf:id="file1" ovf:href="@DISK_FILE@" ovf:size="@DISK_FILE_SIZE@"/>
  </References>
  <DiskSection>
    <Info>The embraOS disk: ESP, two OS slots, STATE and DATA</Info>
    <Disk ovf:diskId="vmdisk1" ovf:fileRef="file1" ovf:capacity="@CAPACITY@" ovf:capacityAllocationUnits="byte" ovf:populatedSize="@DISK_FILE_SIZE@" ovf:format="http://www.vmware.com/interfaces/specifications/vmdk.html#streamOptimized"/>
  </DiskSection>
  <NetworkSection>
    <Info>One network: DHCP first, then the static fallback</Info>
    <Network ovf:name="VM Network">
      <Description>The adapter embraOS asks a DHCP lease on</Description>
    </Network>
  </NetworkSection>
  <VirtualSystem ovf:id="@NAME@">
    <Info>embraOS @VERSION@ (@ARCH@, @ENGINE@)</Info>
    <Name>@NAME@</Name>
    <OperatingSystemSection ovf:id="101" vmw:osType="other6xLinux64Guest">
      <Info>The guest operating system</Info>
      <Description>Other 6.x or later Linux (64-bit)</Description>
    </OperatingSystemSection>
    <VirtualHardwareSection>
      <Info>@CPUS@ vCPU, @MEMORY_MB@ MiB, EFI</Info>
      <System>
        <vssd:ElementName>Virtual Hardware Family</vssd:ElementName>
        <vssd:InstanceID>0</vssd:InstanceID>
        <vssd:VirtualSystemIdentifier>@NAME@</vssd:VirtualSystemIdentifier>
        <vssd:VirtualSystemType>@SYSTEM_TYPE@</vssd:VirtualSystemType>
      </System>
      <Item>
        <rasd:AllocationUnits>hertz * 10^6</rasd:AllocationUnits>
        <rasd:Description>Number of Virtual CPUs</rasd:Description>
        <rasd:ElementName>@CPUS@ virtual CPU(s)</rasd:ElementName>
        <rasd:InstanceID>1</rasd:InstanceID>
        <rasd:ResourceType>3</rasd:ResourceType>
        <rasd:VirtualQuantity>@CPUS@</rasd:VirtualQuantity>
      </Item>
      <Item>
        <rasd:AllocationUnits>byte * 2^20</rasd:AllocationUnits>
        <rasd:Description>Memory Size</rasd:Description>
        <rasd:ElementName>@MEMORY_MB@MB of memory</rasd:ElementName>
        <rasd:InstanceID>2</rasd:InstanceID>
        <rasd:ResourceType>4</rasd:ResourceType>
        <rasd:VirtualQuantity>@MEMORY_MB@</rasd:VirtualQuantity>
      </Item>
@x86_64@      <Item>
@x86_64@        <rasd:Address>0</rasd:Address>
@x86_64@        <rasd:Description>SCSI Controller</rasd:Description>
@x86_64@        <rasd:ElementName>SCSI Controller 0</rasd:ElementName>
@x86_64@        <rasd:InstanceID>3</rasd:InstanceID>
@x86_64@        <rasd:ResourceSubType>VirtualSCSI</rasd:ResourceSubType>
@x86_64@        <rasd:ResourceType>6</rasd:ResourceType>
@x86_64@      </Item>
@aarch64@      <Item>
@aarch64@        <rasd:Address>0</rasd:Address>
@aarch64@        <rasd:Description>NVME Controller</rasd:Description>
@aarch64@        <rasd:ElementName>NVME Controller 0</rasd:ElementName>
@aarch64@        <rasd:InstanceID>3</rasd:InstanceID>
@aarch64@        <rasd:ResourceSubType>vmware.nvme.controller</rasd:ResourceSubType>
@aarch64@        <rasd:ResourceType>20</rasd:ResourceType>
@aarch64@      </Item>
      <Item>
        <rasd:AddressOnParent>0</rasd:AddressOnParent>
        <rasd:ElementName>Hard Disk 1</rasd:ElementName>
        <rasd:HostResource>ovf:/disk/vmdisk1</rasd:HostResource>
        <rasd:InstanceID>4</rasd:InstanceID>
        <rasd:Parent>3</rasd:Parent>
        <rasd:ResourceType>17</rasd:ResourceType>
      </Item>
      <Item>
        <rasd:AddressOnParent>7</rasd:AddressOnParent>
        <rasd:AutomaticAllocation>true</rasd:AutomaticAllocation>
        <rasd:Connection>VM Network</rasd:Connection>
        <rasd:Description>VMXNET3 ethernet adapter on "VM Network"</rasd:Description>
        <rasd:ElementName>Ethernet 1</rasd:ElementName>
        <rasd:InstanceID>5</rasd:InstanceID>
        <rasd:ResourceSubType>VmxNet3</rasd:ResourceSubType>
        <rasd:ResourceType>10</rasd:ResourceType>
      </Item>
@aarch64@      <Item ovf:required="false">
@aarch64@        <rasd:Address>0</rasd:Address>
@aarch64@        <rasd:Description>USB Controller (XHCI)</rasd:Description>
@aarch64@        <rasd:ElementName>USB Controller</rasd:ElementName>
@aarch64@        <rasd:InstanceID>6</rasd:InstanceID>
@aarch64@        <rasd:ResourceSubType>vmware.usb.xhci</rasd:ResourceSubType>
@aarch64@        <rasd:ResourceType>23</rasd:ResourceType>
@aarch64@      </Item>
      <vmw:Config ovf:required="false" vmw:key="firmware" vmw:value="efi"/>
      <vmw:Config ovf:required="false" vmw:key="bootOptions.efiSecureBootEnabled" vmw:value="false"/>
    </VirtualHardwareSection>
    <ProductSection>
      <Info>Product</Info>
      <Product>embraOS</Product>
      <Version>@VERSION@</Version>
      <FullVersion>@VERSION@ (@BUILD_ID@)</FullVersion>
      <ProductUrl>https://github.com/Ward-Software-Defined-Systems/embraOS</ProductUrl>
    </ProductSection>
  </VirtualSystem>
</Envelope>

# The TLS front for Browserless. {$BROWSER_HOST} comes from .env.
#
# Two certificate paths; keep one `tls` line:
#   tls internal
#       Caddy's own CA signs a certificate for BROWSER_HOST (a name or an IP
#       literal). Take its root out of the container, in this compose
#       directory:
#         mkdir -p ca
#         docker compose exec caddy cat /data/caddy/pki/authorities/local/root.crt > ca/browser-root.crt
#       and give it to the OS. On a running machine that is /ca import
#       (from a URL or an upload, by the certificate's SHA-256); on a
#       stopped raw disk image it is
#         ../../../scripts/seed-state.sh --ca-dir ca
#       and Imported_CAs/ is the route into an image before it is built.
#   tls /certs/fullchain.pem /certs/privkey.pem
#       a certificate from your own CA, mounted at /certs (the commented
#       volume in docker-compose.yml); nothing to add on the OS when that
#       CA's root is already trusted there (/ca lists them).
{
	# Never touch the Docker host's trust store.
	skip_install_trust
	# Nothing listens on :80; the compose publishes 443 alone.
	auto_https disable_redirects
	# The certificate a client gets when it names no server. A client that
	# reaches the site by an IP literal sends no server name (RFC 6066), and
	# embraOS's clients are such clients: without this line Caddy finds no
	# certificate for them when BROWSER_HOST is an IP literal.
	default_sni {$BROWSER_HOST}
}

{$BROWSER_HOST} {
	tls internal
	# tls /certs/fullchain.pem /certs/privkey.pem
	reverse_proxy browserless:3000
}

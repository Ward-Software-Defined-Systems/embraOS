# Copy to .env. The compose refuses to start without both values.

# The name (or IP literal) embraOS reaches the service by. It must resolve
# to this Docker host from inside the VM, and it is the site Caddy serves.
BROWSER_HOST=browser.example.lan

# Browserless's token, 32 hex characters: openssl rand -hex 16. Stored in the
# OS once with: /guardian secret <BROWSER_HOST> Authorization "Bearer <token>"
BROWSERLESS_TOKEN=

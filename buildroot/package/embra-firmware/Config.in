# Every family of linux-firmware in one symbol (Phase 2 wave 6, William's
# decision of 2026-11-08: the broad set, S1). The image loads no modules and
# a built-in driver asks for its blobs at probe or at open, so the blobs of
# every wired NIC, HBA, GPU and platform device the kernel fragments build
# are on the rootfs; post_build.sh copies the ones the mandatory drivers
# request at probe into /boot/firmware.cpio.gz, the initrd GRUB loads beside
# the initramfs, and the licence texts beside the binaries.
#
# The select list is generated from Buildroot's package/linux-firmware/
# Config.in:
#   sed -n 's/^config \(BR2_PACKAGE_LINUX_FIRMWARE_.*\)/\tselect \1/p' \
#       buildroot-src/package/linux-firmware/Config.in
# and the image build counts it against that file (assert_firmware_families
# in scripts/lib/image-common.sh): a Buildroot bump that adds a family stops
# the build until the list is regenerated.

config BR2_PACKAGE_EMBRA_FIRMWARE_ALL
	bool "embraOS: every linux-firmware family"
	select BR2_PACKAGE_LINUX_FIRMWARE
	select BR2_PACKAGE_LINUX_FIRMWARE_INTEL_SST_DSP
	select BR2_PACKAGE_LINUX_FIRMWARE_AMD_UCODE
	select BR2_PACKAGE_LINUX_FIRMWARE_AMDGPU
	select BR2_PACKAGE_LINUX_FIRMWARE_CDNS_MHDP8546

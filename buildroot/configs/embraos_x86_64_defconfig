# embraOS x86_64 Buildroot defconfig
# Base: QEMU x86_64

BR2_x86_64=y
# Patches embraOS carries on Buildroot's packages, one directory per package
# under buildroot/patches/ (mesa3d: a NULL device name in
# eglBindWaylandDisplayWL on a software GBM device), applied after the
# package's own. Empty directories are fine; a patch is removed when it lands
# upstream and the bump arrives.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_EMBRAOS_PATH)/patches"
BR2_TOOLCHAIN_BUILDROOT_MUSL=y

# Kernel — the 6.18 longterm line, pinned (LINUX_KERNEL_VERSION in
# scripts/lib/image-common.sh names the same version, and the image scripts
# verify the tarball against scripts/linux-kernel.sha256 before Buildroot
# unpacks it). Buildroot 2026.02's own "latest" is the 6.19 series, end of
# life since 2026-04-22. The headers series moves with the first two digits.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.60"
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
# Kernel configuration — Buildroot's x86_64 defconfig plus the fragment
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"

# SquashFS support in kernel
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_EMBRAOS_PATH)/board/embraos/linux.fragment"

# Filesystem — we build our own images. The root filesystem is a SquashFS,
# mounted read-only by embra-init: nothing is installed or changed on it at
# run time. What is written lives on STATE, DATA or tmpfs.
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
# The squashfs is the slot; nothing reads a rootfs.tar (1.7 GiB a build).
# BR2_TARGET_ROOTFS_TAR is not set

# No default init — embrad is PID 1
BR2_INIT_NONE=y

# No default /etc skeleton
BR2_ROOTFS_SKELETON_DEFAULT=y

# Rootfs overlay (resolv.conf)
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_EMBRAOS_PATH)/board/embraos/rootfs_overlay"

# Post-build and post-image scripts
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_EMBRAOS_PATH)/board/embraos/post_build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_EMBRAOS_PATH)/board/embraos/post_image.sh"

# Image tools. genimage, mcopy, mkdosfs for the EFI System Partition and
# mke2fs for STATE and DATA come from Buildroot, not from the build host:
# the post-image script runs with host/bin and host/sbin first on its PATH,
# so every workstation assembles the image with the same tools.
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_E2FSPROGS=y

# The kernel lands in the rootfs at /boot: each OS slot carries its own kernel
# and initramfs, and GRUB loads them from the slot's squashfs.
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# post_build.sh takes the Rust target as its second argument: the release
# stamp is read from beside the binaries Buildroot picks up
# (target/<triple>/release/embraos-release). post_image.sh ignores it.
BR2_ROOTFS_POST_SCRIPT_ARGS="$(EMBRAOS_RUST_TARGET)"

# GRUB on the EFI System Partition, EFI only: the loader at EFI/BOOT/<arch>.efi
# (the removable-media path, so no NVRAM entry), grub.cfg and grubenv beside
# it (post_image.sh). Every module is built in — the ESP carries no module
# directory — and grub-mkimage resolves their dependencies; the builtin
# config stays empty, `normal` loads $prefix/grub.cfg itself. No GRUB tools
# on the rootfs: the OS writes grubenv through embra-boot.
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux normal configfile part_gpt fat squash4 xzio gzio echo test true sleep loadenv regexp smbios probe search search_fs_uuid search_label halt reboot efifwsetup minicmd cat ls help terminal efi_gop"
# BR2_TARGET_GRUB2_INSTALL_TOOLS is not set

# OpenSSL + libcurl with TLS (required for git-remote-https)
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_LIBCURL_CURL=y

# Git (15+ tools depend on this)
BR2_PACKAGE_GIT=y

# OpenSSH client only — NO server (security invariant)
# The server is a sub-option that is ON unless it is switched off: naming the
# client alone built and shipped sshd. post_build.sh removes what an earlier
# build left in the target directory, and the image scripts check the result.
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_CLIENT=y
# BR2_PACKAGE_OPENSSH_SERVER is not set

# embraOS packages
BR2_PACKAGE_EMBRAD=y
BR2_PACKAGE_EMBRA_APID=y
BR2_PACKAGE_EMBRA_TRUSTD=y
# The installer's tools (embra-update install, the image's own partitioning
# and filesystems on a local disk): sgdisk writes the GPT, mke2fs makes STATE
# and DATA, mkfs.fat the ESP, resize2fs grows DATA to the disk. The same
# e2fsprogs and dosfstools genimage used on the build host, so an installed
# disk carries the image's filesystems. BusyBox's mke2fs (ext2 only) and
# mkdosfs are replaced by these real binaries.
BR2_PACKAGE_GPTFDISK=y
# BR2_PACKAGE_GPTFDISK_GDISK is not set
BR2_PACKAGE_GPTFDISK_SGDISK=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y

BR2_PACKAGE_EMBRA_BRAIN=y
BR2_PACKAGE_EMBRA_CONSOLE=y
BR2_PACKAGE_EMBRA_WEB=y
BR2_PACKAGE_EMBRA_RUST_TOOLCHAIN=y
BR2_PACKAGE_EMBRA_EMBEDDING_MODEL=y
BR2_PACKAGE_WARDSONDB=y
BR2_PACKAGE_EMBRA_UPDATE=y


# The display console (Phase 2): the web console rendered on the machine's
# display by WPE WebKit through cog's DRM platform, drawn in software (Mesa's
# kms_swrast/llvmpipe on LLVM), input through libinput over eudev, which
# embrad starts (no hardware database, no module loading: this image loads no
# modules). No compositor: cog's Wayland platform needs a DRM render node,
# and the displays this image boots on (simpledrm, bochs, hyperv_drm) have
# none, so cage and cog's Wayland platform could never show a frame. The C++
# toolchain is for this stack and for sgdisk; switching it on rebuilds the
# tree once. Sandbox, multimedia and WebDriver stay off; libsoup3 gets HTTPS
# (not selected by wpewebkit); DejaVu Sans and Sans Mono are the fonts.
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
# BR2_PACKAGE_EUDEV_MODULE_LOADING is not set
# BR2_PACKAGE_EUDEV_ENABLE_HWDB is not set
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_XKEYBOARD_CONFIG=y
BR2_PACKAGE_DEJAVU=y
# BR2_PACKAGE_DEJAVU_SERIF is not set
# BR2_PACKAGE_DEJAVU_SANS_CONDENSED is not set
# BR2_PACKAGE_DEJAVU_SERIF_CONDENSED is not set
BR2_PACKAGE_LIBSOUP3_SSL=y
BR2_PACKAGE_WPEWEBKIT=y
BR2_PACKAGE_COG=y
BR2_PACKAGE_COG_PROGRAMS_HOME_URI=""
# BR2_PACKAGE_COG_PLATFORM_FDO is not set
BR2_PACKAGE_COG_PLATFORM_DRM=y

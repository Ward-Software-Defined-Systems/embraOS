/* Template — post_image.sh renders @ESP_SIZE@, @SLOT_SIZE@, @STATE_SIZE@,
 * @DATA_SIZE@ and @IMAGE_SIZE@ from layout.sh into $(BUILD_DIR)/genimage.cfg.
 * One committed config builds both arches; the kernel is inside each slot's
 * squashfs.
 *
 * The layout, 1 MiB aligned (partition 1 starts at sector 2048; post_image.sh
 * and scripts/lib/image-common.sh check it): the EFI System Partition carries
 * GRUB and its state and nothing else; each rootfs slot is one squashfs that
 * carries its own kernel and initramfs under /boot; rootfs_b is a sized hole
 * at build time, filled by the first OS update. The GPT names are what
 * embra-init, embra-update and the host scripts look partitions up by;
 * layout.sh lists them in the same order. */

image esp.vfat {
    vfat {
        label = "ESP"
        file EFI {
            image = "efi-part/EFI"
        }
    }
    size = @ESP_SIZE@
}

/* rootfs.squashfs is pre-built by Buildroot — genimage finds it in the images dir */

image state.ext4 {
    ext4 {
        label = "STATE"
        use-mke2fs = true
    }
    size = @STATE_SIZE@
    empty = true
}

image data.ext4 {
    ext4 {
        label = "DATA"
        use-mke2fs = true
    }
    size = @DATA_SIZE@
    empty = true
}

image embraos.img {
    hdimage {
        partition-table-type = "gpt"
        align = 1M
    }
    /* A whole number of MiB (layout.sh says why); genimage puts the backup
     * GPT on the last sector of this size, and post_image.sh reads it back. */
    size = @IMAGE_SIZE@

    partition esp {
        partition-type-uuid = esp
        image = esp.vfat
    }

    partition rootfs_a {
        partition-type-uuid = linux
        image = rootfs.squashfs
        size = @SLOT_SIZE@
    }

    partition rootfs_b {
        partition-type-uuid = linux
        size = @SLOT_SIZE@
    }

    partition state {
        partition-type-uuid = linux
        image = state.ext4
    }

    partition data {
        partition-type-uuid = linux
        image = data.ext4
    }
}

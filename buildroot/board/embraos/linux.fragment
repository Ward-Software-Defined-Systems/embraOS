CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
# UEFI boot through GRUB and the EFI System Partition, pinned here so a
# Buildroot or base-defconfig change cannot drop them (the base configs of
# both architectures set them today; CONFIG_EFI_HANDOVER_PROTOCOL is x86-only
# and stays out of this shared fragment).
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# Phase 2: the storage and network devices other hypervisors present (NVMe,
# VMware's vmxnet3, pvscsi and its two LSI Logic controllers, Hyper-V's
# synthetic storage, network, video and keyboard; the x86-only symbols are
# dropped from the aarch64 kernel by the merge with a notice), the display
# console (the firmware's framebuffer through sysfb and simpledrm, QEMU's
# standard VGA through bochs, fbcon on the kernel line as console=tty0 beside
# the serial line), and nf_tables for the packet filter to come (built,
# unused until then).
CONFIG_BLK_DEV_NVME=y
CONFIG_VMXNET3=y
CONFIG_VMWARE_PVSCSI=y
# VMware's LSI Logic Parallel (LSI 53C1030) and LSI Logic SAS (SAS1068)
# controllers, ESXi's defaults for most guest types and the pick when a
# controller list is blank: the Fusion MPT drivers mptspi and mptsas, under
# the family's switch (PCI and I/O ports; both architectures have them).
# Without them a disk on either controller is invisible to the kernel and
# embra-init halts on a blank display.
CONFIG_FUSION=y
CONFIG_FUSION_SPI=y
CONFIG_FUSION_SAS=y
CONFIG_HYPERV=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_HYPERV_BALLOON=y
CONFIG_HYPERV_UTILS=y
CONFIG_HYPERV_KEYBOARD=y
CONFIG_DRM_HYPERV=y
# DRM itself is named: the arm64 base config builds it as a module, and a
# driver cannot be built in above its subsystem, so without this line the
# merge demotes simpledrm, bochs and the Hyper-V driver to modules that
# nothing in the image loads, and the display stays black after GRUB.
CONFIG_DRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_BOCHS=y
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# The display console's pointer: VMware's vmmouse, the absolute pointer on
# the PS/2 port ESXi presents (x86-only; dropped from the aarch64 kernel by
# the merge with a notice), and Hyper-V's synthetic mouse, the one pointer a
# generation 2 VM has. QEMU's USB and virtio tablets, Parallels' USB tablet
# and bare-metal USB mice ride USB_HID, HID_GENERIC and VIRTIO_INPUT, built
# in by the base configuration.
CONFIG_MOUSE_PS2_VMMOUSE=y
CONFIG_HID_HYPERV_MOUSE=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_NAT=y

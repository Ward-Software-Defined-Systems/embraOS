CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
# UEFI boot through GRUB and the EFI System Partition, pinned here so a
# Buildroot or base-defconfig change cannot drop them (the base configs of
# both architectures set them today; CONFIG_EFI_HANDOVER_PROTOCOL is x86-only
# and stays out of this shared fragment).
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# The frequency governor a policy starts under: `performance`, the highest
# setting every driver has. The x86_64 base configuration says `userspace`,
# which holds a core at the frequency it was found at until something writes
# another, and nothing in this image does: on a CPU without hardware
# P-states (intel_pstate then runs passive and starts a policy at its
# minimum) every core stayed at its lowest frequency. Under `performance` a
# core that is awake runs at the top of its range: the governor of that name
# for a driver that is handed a frequency (intel_pstate passive,
# acpi-cpufreq, the arm64 drivers), and the policy of that name for one that
# governs itself (intel_pstate with hardware P-states, amd-pstate), whose own
# first choice is `powersave`. An idle core still sleeps, and the kernel's
# thermal limits still lower the ceiling the governor runs at. arm64's base
# configuration names no default, which the kernel reads as schedutil.
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_USERSPACE is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set
# Phase 2: the storage and network devices other hypervisors present (NVMe,
# virtio-scsi, VMware's vmxnet3 and its two LSI Logic controllers, Hyper-V's
# synthetic storage, network, video and keyboard; VMware's pvscsi is x86-only
# and lives in linux-x86_64.fragment), the display console (the firmware's
# framebuffer through sysfb and simpledrm, QEMU's standard VGA through
# bochs, fbcon on the kernel line as console=tty0 beside the serial line),
# and nf_tables for the packet filter to come (built, unused until then).
# Every line of this file merges on both architectures with nothing dropped
# (the read-back assert in scripts/lib/image-common.sh), so a symbol names
# the subsystems it needs built in beside it.
# NVMe and VMware's vmxnet3 are also what the OVA declares
# (scripts/lib/embraos.ovf.in): the adapter on both architectures, and the
# disk controller on aarch64, where pvscsi has no driver.
CONFIG_BLK_DEV_NVME=y
CONFIG_VMXNET3=y
# virtio-scsi (QEMU's virtio-scsi-pci; VirtualBox's default disk controller
# for an Arm Linux guest): the x86_64 base config builds it in and the arm64
# one leaves it out, so without this line a disk behind it is invisible to
# the aarch64 kernel. SCSI and the SCSI disk driver are built in by both
# base configurations.
CONFIG_SCSI_VIRTIO=y
# VMware's LSI Logic Parallel (LSI 53C1030) and LSI Logic SAS (SAS1068)
# controllers, ESXi's defaults for most guest types and the pick when a
# controller list is blank: the Fusion MPT drivers mptspi and mptsas, under
# the family's switch (PCI and I/O ports; both architectures have them).
# Without them a disk on either controller is invisible to the kernel and
# embra-init halts on a blank display.
CONFIG_FUSION=y
CONFIG_FUSION_SPI=y
CONFIG_FUSION_SAS=y
CONFIG_HYPERV=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_HYPERV_BALLOON=y
CONFIG_CONNECTOR=y
CONFIG_HYPERV_UTILS=y
CONFIG_HYPERV_KEYBOARD=y
CONFIG_DRM_HYPERV=y
# DRM itself is named: the arm64 base config builds it as a module, and a
# driver cannot be built in above its subsystem, so without this line the
# merge demotes simpledrm, bochs and the Hyper-V driver to modules that
# nothing in the image loads, and the display stays black after GRUB.
CONFIG_DRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_BOCHS=y
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# The display console's pointers: Hyper-V's synthetic mouse (the one pointer
# a generation 2 VM has), QEMU's virtio tablet and virtio-gpu, named because
# the arm64 base config leaves them out. QEMU's USB tablet, Parallels' and
# bare-metal USB mice ride USB_HID and HID_GENERIC, built in by both base
# configurations; VMware's vmmouse is PS/2 and lives in the x86 fragment.
CONFIG_HID_HYPERV_MOUSE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_IPV6=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_NAT=y
# The packet filter's helpers, built in rather than as the modules the x86
# base config makes of them: this image loads no module but a wireless
# driver (the Wi-Fi block at the end of this file; the x86 rootfs carries no
# other, and the read-back assert in scripts/lib/image-common.sh checks
# every line of this file against the built configuration).
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_LOG_SYSLOG=y
CONFIG_NF_LOG_ARP=y
CONFIG_NF_LOG_IPV4=y
CONFIG_NF_LOG_IPV6=y
# Bare metal and the wider hypervisor fleet (Phase 2 wave 6), every driver
# built in. The wired NICs of servers and desktops on PCIe (the e1000, e1000e,
# r8169, tg3, sky2, 8139too and forcedeth of the base configs stay):
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_IXGBE=y
CONFIG_I40E=y
# (the E800's driver wants the GNSS subsystem built in or absent; the arm64
# base config builds it as a module)
CONFIG_GNSS=y
CONFIG_ICE=y
CONFIG_BNX2=y
CONFIG_BNX2X=y
CONFIG_BNXT=y
CONFIG_AQTION=y
CONFIG_MLX4_CORE=y
CONFIG_MLX4_EN=y
CONFIG_MLX5_CORE=y
CONFIG_MLX5_CORE_EN=y
CONFIG_ALX=y
CONFIG_8139CP=y
CONFIG_QED=y
CONFIG_QEDE=y
CONFIG_CHELSIO_T4=y
# USB network adapters (the dock and the dongle):
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_CDC_EEM=y
CONFIG_USB_NET_RNDIS_HOST=y
# Storage: the RAID and SAS HBAs of servers, SD/eMMC, the remaining SATA
# controllers, the NVMe temperature sensor, USB 3 sticks as UAS, Thunderbolt
# and PCIe hotplug.
CONFIG_MEGARAID_SAS=y
CONFIG_SCSI_MPT3SAS=y
CONFIG_SCSI_MPI3MR=y
CONFIG_SCSI_SMARTPQI=y
CONFIG_SCSI_HPSA=y
CONFIG_SCSI_AACRAID=y
CONFIG_SCSI_ARCMSR=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_ATA_GENERIC=y
CONFIG_SATA_SIL24=y
CONFIG_SATA_NV=y
CONFIG_SATA_VIA=y
CONFIG_SATA_SIL=y
CONFIG_SATA_PROMISE=y
CONFIG_NVME_HWMON=y
CONFIG_USB_UAS=y
CONFIG_USB4=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
# Input on laptops and touch displays: multitouch HID and the Synaptics RMI4
# bus (HID over I2C is selected by its ACPI transport in the x86 fragment).
CONFIG_HID_MULTITOUCH=y
CONFIG_RMI4_CORE=y
CONFIG_RMI4_SMB=y
# Filesystems and the platform: UDF for optical media, EFI variables for the
# installer's follow-ups, the DMI tables in sysfs, the TPM for the encryption
# to come, the BMC video of servers (ASPEED, Matrox), the console fonts the
# kernel picks from by display size (Terminus 16x32 for 4K).
CONFIG_UDF_FS=y
CONFIG_EFIVAR_FS=y
CONFIG_DMI_SYSFS=y
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_DRM_AST=y
CONFIG_DRM_MGAG200=y
CONFIG_FONTS=y
CONFIG_FONT_8x8=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
# The installer medium (embraos.iso) on both architectures: embra-init mounts
# it as ISO 9660 whether it is a DVD or a USB stick, and a virtual DVD drive
# is a SCSI CD-ROM to the kernel (sr: behind AHCI, USB mass storage and
# virtio-scsi alike). The x86_64 base config builds both in and the arm64
# one neither, so without these lines an aarch64 medium boots its kernel
# and embra-init never finds it. The medium's names are Rock Ridge, which
# the driver prefers; Joliet is not needed.
CONFIG_ISO9660_FS=y
CONFIG_BLK_DEV_SR=y
# Wi-Fi. The 802.11 stack and the drivers of the card families linux-firmware
# serves are MODULES, the first this image loads. Every Wi-Fi driver asks for
# its firmware when it probes, and a driver that is built in probes before
# the root filesystem and its /lib/firmware are there; the files it wants
# cannot be named ahead of time either (iwlwifi asks for a range of versions,
# ath11k and brcmfmac for names made from the board, ath12k declares none).
# So embrad loads the driver a card needs once the root filesystem is
# mounted (crates/embrad/src/wifi.rs, from /usr/share/embra/wireless.alias,
# which post_build.sh writes from modules.alias: wireless drivers and no
# other), the firmware is read from /lib/firmware like any file, and
# cfg80211 finds the regulatory database the same way. On x86_64 these are
# the only modules in the image (assert_kernel_fragments_applied).
# embra.wifi=0 on the kernel line loads none of them for that boot.
CONFIG_CFG80211=m
CONFIG_MAC80211=m
# Intel: AC 7260 to AX211, BE200 and BE201 (iwlmvm, iwlmld), the 5000 and
# 6000 series (iwldvm).
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
# Realtek: rtw88 (8822, 8821, 8723, 8812, 8814 on PCIe, USB and SDIO), rtw89
# (8851, 8852, 8922), rtl8xxxu (the 8188 and 8192 USB dongles), rtlwifi (the
# older PCIe cards and two USB ones).
CONFIG_RTW88=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8814AE=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8822CU=m
CONFIG_RTW88_8723DU=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8821AU=m
CONFIG_RTW88_8812AU=m
CONFIG_RTW88_8814AU=m
CONFIG_RTW88_8723CS=m
CONFIG_RTW88_8723DS=m
CONFIG_RTW88_8821CS=m
CONFIG_RTW88_8822BS=m
CONFIG_RTW88_8822CS=m
CONFIG_RTW89=m
CONFIG_RTW89_8851BE=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852BTE=m
CONFIG_RTW89_8852CE=m
CONFIG_RTW89_8922AE=m
CONFIG_RTW89_8851BU=m
CONFIG_RTW89_8852BU=m
# An SoC's own radio that the arm64 base configuration turns on (Qualcomm's
# WCN36xx): its device sits on no bus embrad looks at, so nothing in this
# image would load its driver, and its firmware is named by the board's
# device tree, not by the one name its module declares, so the build could
# not vouch for it (the firmware table refuses a driver none of whose
# names is served, and linux-firmware has no file of that name).
# CONFIG_WCN36XX is not set
# The RTL8852A over USB (the AX1800 adapters). Its driver came to the kernel
# with 6.19, and this symbol with it: buildroot/patches/linux carries the
# eighteen upstream commits onto the pinned 6.18, each naming its own
# (the driver and what it rests on in rtw89's USB code, and the id of one
# adapter that came with 7.0). Two more of that series are in 6.18.60
# already, and two, the transmit-status handling for USB, do not apply to
# it and are left out; the chips 6.18 drives over USB run without them too.
# The line is read back like every line here, so a kernel built without the
# patches stops the image build. A kernel pin that moves to a line with the
# driver drops the patches and keeps this line.
CONFIG_RTW89_8852AU=m
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_RTL_CARDS=m
CONFIG_RTL8192CE=m
CONFIG_RTL8192SE=m
CONFIG_RTL8192DE=m
CONFIG_RTL8723AE=m
CONFIG_RTL8723BE=m
CONFIG_RTL8188EE=m
CONFIG_RTL8192EE=m
CONFIG_RTL8821AE=m
CONFIG_RTL8192CU=m
CONFIG_RTL8192DU=m
# Qualcomm Atheros: ath9k (AR9xxx on PCIe, and the USB dongles through
# ath9k_htc), ath10k (QCA6174, QCA9377), ath11k (QCA6390, WCN6855), ath12k
# (WCN7850).
CONFIG_ATH9K=m
CONFIG_ATH9K_PCI=y
CONFIG_ATH9K_HTC=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
# MediaTek and Ralink: MT7921 and MT7922, MT7925, MT7615 and MT7663, the
# MT76x0, MT76x2 and MT7601 dongles, and the RT2800 family.
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_MT7921S=m
CONFIG_MT7925E=m
CONFIG_MT7925U=m
CONFIG_MT7615E=m
CONFIG_MT7663U=m
CONFIG_MT76x0U=m
CONFIG_MT76x0E=m
CONFIG_MT76x2U=m
CONFIG_MT76x2E=m
CONFIG_MT7601U=m
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_RT2800PCI=m
CONFIG_RT2800PCI_RT33XX=y
CONFIG_RT2800PCI_RT35XX=y
CONFIG_RT2800PCI_RT53XX=y
CONFIG_RT2800PCI_RT3290=y
# Broadcom FullMAC (BCM43xx) on PCIe, USB and SDIO.
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMFMAC_USB=y
CONFIG_BRCMFMAC_SDIO=y
# Built in, because no line of modules.dep leads to them from a driver: the
# transport ath11k and ath12k talk to their firmware over (QRTR is a socket
# family, and its MHI side sits on a bus embrad does not scan), and Michael
# MIC, which TKIP asks for by name.
CONFIG_MHI_BUS=y
CONFIG_QRTR=y
CONFIG_QRTR_MHI=y
CONFIG_CRYPTO_MICHAEL_MIC=y

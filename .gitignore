data/
*.db
*.log

# Build outputs (disk images, initramfs, Buildroot)
output/
initramfs.cpio.gz
buildroot-src/

# embra-guardian-v1 in-OS Rust toolchain — large prebuilt dist staged by
# build-image.sh Step 3.5 into /opt/rust in the rootfs; never committed.
/vendor/rust-toolchain/
/vendor/embedding-model/

# embra-web frontend bundle — Trunk/WASM output, regenerated by
# build-image.sh Step 0.5 and embedded into embra-web via rust-embed.
crates/embra-web-ui/dist/

# Cargo (linker config is per-machine, lives in ~/.cargo/config.toml)
.cargo/


# OS
.DS_Store
Thumbs.db

# Environment, keys, certificates, and a STATE or DATA tree copied beside
# the sources: none of it is ever committed (`.env.example` is, so `.env.*`
# is not listed).
.env
*.pem
*.key
*.crt
id_rsa*
id_ed25519*
api_key*
DATA/
STATE/

